texto = input("Digite uma palavra: ")

for letra in texto:
    codigo = ord(letra)

    print(
        letra,
        "->",
        codigo,
        "->",
        "{:08b}".format(codigo,)
    )

print()

caracteres = len(texto)
print(f"Caracteres: {caracteres}")
bytes_texto = len(texto.encode("utf-8"))
print(f"Bytes: {bytes_texto}")
bits = bytes_texto * 8
print(f"Bits: {bits}")
